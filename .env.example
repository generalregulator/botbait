# Copy to .env and edit.  chmod 600 .env   (it will contain the Telegram token)
# Real environment variables always take precedence over this file.

# ---- Host port mapping (docker-compose; uncomment to change) ----------------------
#HP_HOST_PORT_ADB=5555
#HP_HOST_PORT_TR069=7547
#HP_HOST_PORT_TELNET=23
#HP_HOST_PORT_HIKVISION=80
#HP_HOST_PORT_TVT=81
#HP_HOST_PORT_DAHUA=8080

# ---- Listeners -----------------------------------------------------------------
# Container-side ports. Compose maps 23 -> 2323 and 80 -> 8088 on the host.
HP_PORTS=5555,7547,2323,8088,8081,8080
# Ports where the server speaks first (login banner) instead of waiting for data.
HP_TELNET_PORTS=23,2323
# Web "camera / DVR" personas: container port = vendor (hikvision, dahua, tvt).
HP_WEB_PORTS=8088=hikvision,8081=tvt,8080=dahua
# Port shown in alerts and telemetry when it differs from the container port.
HP_PORT_LABELS=2323:23,8088:80,8081:81

# ---- Connection limits (DoS / Slowloris protection) -------------------------
HP_MAX_CONNS=256              # worker pool size = max concurrent sessions
HP_MAX_CONNS_PER_IP=8         # concurrent sessions per source address
HP_QUEUE_SIZE=256             # accepted-but-waiting connections before dropping
HP_READ_TIMEOUT=5s            # idle timeout per read
HP_WRITE_TIMEOUT=5s
HP_SESSION_TIMEOUT=20s        # absolute lifetime of a connection
HP_MAX_READ_BYTES=65536       # bytes read per connection
HP_SHUTDOWN_TIMEOUT=20s

# ---- Token-bucket admission control (per source subnet) ----------------------
HP_RATE_PER_SEC=1             # sustained new connections / second / subnet
HP_RATE_BURST=10
HP_RATE_PREFIX_V4=24          # aggregate IPv4 sources by /24
HP_RATE_PREFIX_V6=64

# ---- Payload capture (hard ceilings: 5s, 15 MiB) --------------------------------
HP_DOWNLOAD_ENABLED=true
HP_PAYLOAD_DIR=/app/captured_payloads
HP_DOWNLOAD_TIMEOUT=5s
HP_MAX_DOWNLOAD_BYTES=15728640
HP_MAX_DOWNLOADS_PER_EVENT=3
HP_DOWNLOAD_WORKERS=4
HP_MAX_STORAGE_MB=512         # stop capturing when the directory reaches this size

# ---- ADB push / dropper capture ----------------------------------------------
# Store files attackers push with `adb push` or assemble with `echo -e "\x7f..." >> f`.
# Samples go to HP_PAYLOAD_DIR (content-addressed, mode 0600, never executed) and
# count against HP_MAX_STORAGE_MB. Set to false to record them without storing.
HP_CAPTURE_PUSH=true
HP_MAX_PUSH_BYTES=15728640    # bytes a single session may push (hard ceiling: 15 MiB)
HP_PUSH_SESSION_TIMEOUT=60s   # session deadline once a push starts (ceiling: 120s)

# ---- Device persona (what attackers see) -----------------------------------------
# Built-in profiles: android-tvbox, router-busybox. A path to your own JSON file
# also works (mount it read-only into the container, see docs/PROFILES.md).
HP_PROFILE=android-tvbox
# Persona on the Telnet ports. Mirai-family scanners expect a BusyBox router, so the
# shipped default differs from the ADB persona; leave empty to use HP_PROFILE
# everywhere (a single coherent device per IP).
HP_TELNET_PROFILE=router-busybox
# Seeds serial/MAC/IP. Empty = random, generated once and kept in HP_LOG_DIR/profile.seed
# so the "device" does not change when the container restarts.
HP_PROFILE_SEED=

# ---- Telemetry / pipeline ------------------------------------------------------
HP_LOG_DIR=/app/data
HP_LOG_LEVEL=info
HP_PIPELINE_WORKERS=8
HP_EVENT_QUEUE=1024
HP_STORE_PAYLOAD_MAX=8192     # payload bytes kept per event in JSONL

# ---- ASN / country enrichment (ip-api.com, free tier is HTTP and 45 req/min) ----
HP_ENRICH_ENABLED=true
HP_ENRICH_TIMEOUT=3s

# ---- Telegram alerting (leave empty to disable) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HP_TG_PER_MIN=20              # global Telegram budget (token bucket)
HP_TG_BURST=5
HP_ALERT_COOLDOWN=6h          # same attacker repeating the same attack: alert once per window (0 = off)
HP_ALERT_CAMPAIGN_COOLDOWN=6h # same payload URL / file hash from ANY address: alert once per window (0 = off)
#HP_ALERT_STATE=              # remembered alerts survive restarts; default <HP_LOG_DIR>/alert-state.json, "off" disables
# ---- Hide this server's own address in Telegram alerts ---------------------------
# Attackers put your address into the request (Host: header, URLs). Alerts show it as [REDACTED],
# so a public channel does not reveal where the sensor lives. Logs on disk keep the raw text.
HP_REDACT_ENABLED=true
HP_REDACT_AUTODETECT=true     # learn the addresses of this machine's interfaces and its public IP at start (and every 6 h)
HP_PUBLIC_IP_URL=https://api.ipify.org   # one HTTPS GET returning your public IP as plain text; "off" = do not look it up
#HP_REDACT=                   # extra addresses or host names to hide, comma separated (e.g. 203.0.113.5,sensor.example.com)

# ---- AbuseIPDB auto-reporting (optional) -----------------------------------
# Confirmed attacks (the ones that produce an alert) are reported to AbuseIPDB: categories, a short
# comment with de-fanged links, never your server address or the request body.
# Empty = off. Free key: https://www.abuseipdb.com/account/api (1000 reports/day)
ABUSEIPDB_API_KEY=
HP_ABUSE_REPORT=true          # false pauses reporting without removing the key
HP_ABUSE_REPORT_BRUTE=true    # report pure credential brute-forcing (category 18) to AbuseIPDB; Telegram stays quiet (see HP_ALERT_ON_BRUTE)
HP_ABUSE_WINDOW=24h           # report the same address at most once per window (min 1h)
#HP_ABUSE_STATE=              # default <HP_LOG_DIR>/abuseipdb-state.json, "off" disables

HP_ALERT_PAYLOAD_MAX=1200     # payload characters shown per alert (100..3000)
HP_ALERT_ON_BRUTE=false       # also alert on pure credential brute-forcing

# ---- Weekly digest (posted to the same Telegram chat) --------------------------
# Sessions, unique IPs, top ASNs / countries and most frequent commands for the
# last 7 days. Needs the Telegram settings above. No file hashes are included.
HP_DIGEST_ENABLED=true
HP_DIGEST_DAY=mon             # mon..sun, UTC
HP_DIGEST_AT=09:00            # HH:MM, UTC
HP_DIGEST_TOP=10              # entries per ranking (1..10)
HP_DIGEST_ENRICH_MAX=200      # extra ASN/country lookups for scan-only IPs (0..500, 0 = off)

# ---- Observability (bind to loopback only) -----------------------------------
HP_METRICS_ADDR=127.0.0.1:9100
